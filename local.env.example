# Copy to local.env (gitignored) and fill in. Not secret, but specific to one workspace.
# The SQL warehouse HTTP path: SQL Warehouses > your warehouse > Connection details.
TAXI_WAREHOUSE_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>

# Optional quota guard, off when unset: the absolute path of a quota log shared with other projects on the same
# Databricks account. scripts/ledger.sh refuses to start a run while the log's last stop line is a QUOTA-STOP.
# For Airflow, export the same path as TAXI_QUOTA_LOG_FILE before `docker compose up`.
# TAXI_QUOTA_LOG=/absolute/path/to/QUOTA.log
